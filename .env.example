# Configuración de Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_smartcset
DB_USER=postgres
DB_PASS=ander123

# Colores Corporativos
COLOR_VERDE_OSCURO=#004d40
COLOR_VERDE_OLIVA=#808000

# Ruta del Logo
PATH_LOGO=img/logo-sena.png

# Zona horaria (PostgreSQL suele guardar en UTC; la UI muestra hora Colombia)
DB_TIMEZONE=UTC
APP_TIMEZONE=America/Bogota

# Presencia de sesión (admin: Activo / Ausente / Desconectado)
SESION_PRESENCIA_ACTIVO_MIN=5
# Intervalo del heartbeat JS (segundos); alinea el throttle de touch en navegación
SESION_HEARTBEAT_SEG=60
