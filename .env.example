# Configuración de Base de Datos
DB_HOST=xcxcxcxc
DB_PORT=xcxcxcxc
DB_NAME=xcxcxcxc
DB_USER=xcxcxcxc
DB_PASS=cxxcxcxc

# Modo SSL de la conexión PHP->PostgreSQL (vacío = sin forzar TLS, comportamiento actual).
# Activar 'require' (cifra sin validar certificado) o 'verify-full' (valida CN del
# certificado, recomendado en producción) SOLO cuando PostgreSQL tenga ssl=on configurado
# (postgresql.conf + certificados) — ver Fase 1 Entregable 8. Si se activa sin que el
# servidor soporte SSL, la conexión fallará.
DB_SSLMODE=

# Clave de cifrado para datos sensibles en reposo (pgcrypto, ver Fase 1 Entregable 2).
# Generar con: openssl rand -base64 32
# NUNCA commitear el valor real. En producción, custodiada según prerrequisito 1 (FASE1-CHK-002 §18).
DB_ENCRYPTION_KEY=

# Colores Corporativos
COLOR_VERDE_OSCURO=#004d40
COLOR_VERDE_OLIVA=#808000

# Ruta del Logo (relativa al document root public/)
PATH_LOGO=assets/img/logo-sena.png

# Almacenamiento de fotos portería (relativo a la raíz del proyecto)
STORAGE_PORTERIA_PATH=storage/porteria

# Fotos de enrolamiento facial (absoluta o relativa a la raíz del proyecto).
# Producción (111): /var/www/html/smartcset/src/frontend/img/biometria
# Dev local (default si se omite): frontend/web/public/uploads/biometria
BIOMETRIA_FOTO_PATH=/var/www/html/smartcset/src/frontend/img/biometria

# Zona horaria de sesión PDO (timestamp without time zone = hora local Colombia)
DB_TIMEZONE=America/Bogota
APP_TIMEZONE=America/Bogota

# Presencia de sesión (admin: Activo / Ausente / Desconectado)
SESION_PRESENCIA_ACTIVO_MIN=5
# Intervalo del heartbeat JS (segundos); alinea el throttle de touch en navegación
SESION_HEARTBEAT_SEG=60

# Comparar IP de cada request con ip_cliente guardada al login (1=activo, 0=desactivar)
SESION_VALIDAR_IP=1
# Solo si hay proxy reverso confiable del centro (1=leer X-Forwarded-For)
SESION_TRUST_PROXY=0

# Prefijo URL si la app está bajo subcarpeta.
# Apache local y producción: APP_BASE_PATH=smartcset
# PHP built-in (php -S, sin subcarpeta): dejar vacío.
APP_BASE_PATH=smartcset

# E3 — Rate limiting de login (bloqueo por IP)
# LOGIN_MAX_INTENTOS: intentos fallidos antes de bloquear la IP (default 5)
# LOGIN_VENTANA_MINUTOS: ventana de tiempo en minutos para contar intentos (default 15)
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

