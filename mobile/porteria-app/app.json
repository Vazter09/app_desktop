{
  "expo": {
    "name": "SmartCSET Portería",
    "slug": "smartcset-porteria",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "smartcset-porteria",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#004d40"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.edu.sena.smartcset.porteria"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#004d40"
      },
      "package": "co.edu.sena.smartcset.porteria",
      "minSdkVersion": 24,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite capturar foto en el registro de portería."
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7ee67b30-6f21-4f37-9a8a-39f756795891"
      }
    },
    "owner": "kevinbermudez"
  }
}
